---
import { site, waLink } from '../config';

const nav = [
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Tablas', href: '#tablas' },
  { label: 'Eventos', href: '#eventos' },
  { label: 'Galería', href: '#galeria' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-500"
  data-header
>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div
      class="flex items-center justify-between py-4 md:py-5 border-b border-transparent transition-colors duration-500"
      data-header-inner
    >
      <!-- Logo -->
      <a href="#top" class="flex items-center gap-3 group">
        <img
          src="/logo.png"
          alt="Las Tablas de Titto"
          width="48"
          height="48"
          class="h-11 w-11 md:h-12 md:w-12 rounded-full object-contain bg-[#fbf6f0] p-0.5 ring-1 ring-gold/30 shadow-md transition-transform group-hover:scale-105"
        />
        <span class="flex flex-col leading-none">
          <span
            class="font-display text-lg md:text-xl font-semibold tracking-wide text-cream group-hover:text-gold-light transition-colors"
            >Las Tablas de Titto</span
          >
          <span class="mt-1 text-[0.55rem] md:text-[0.62rem] uppercase tracking-widest2 text-gold/80"
            >Charcutería · Vino · Experiencias</span
          >
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-9">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="relative text-sm text-muted hover:text-cream transition-colors after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-gold after:transition-all hover:after:w-full"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={waLink(`Hola ${site.name}, me gustaría hacer un pedido.`)}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-gold/50 bg-gold/10 px-4 py-2 text-sm font-medium text-gold-light hover:bg-gold hover:text-charcoal transition-colors"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12 2a10 10 0 0 0-8.53 15.26L2 22l4.86-1.27A10 10 0 1 0 12 2z"
          ></path></svg
        >
        <span class="hidden sm:inline">Pedir</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Fondo del header al hacer scroll
  const header = document.querySelector('[data-header-inner]');
  const outer = document.querySelector('[data-header]');
  const onScroll = () => {
    if (window.scrollY > 20) {
      outer?.classList.add('bg-charcoal/85', 'backdrop-blur-md', 'shadow-card');
      header?.classList.add('border-gold/15');
    } else {
      outer?.classList.remove('bg-charcoal/85', 'backdrop-blur-md', 'shadow-card');
      header?.classList.remove('border-gold/15');
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

---
import { site, contacto, waLink } from '../config';
---

<footer id="contacto" class="relative pt-24 md:pt-32 pb-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -bottom-32 left-1/2 h-[400px] w-[600px] -translate-x-1/2 rounded-full bg-gold/8 blur-[120px]"></div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
    <!-- CTA final -->
    <div class="reveal text-center max-w-2xl mx-auto">
      <h2 class="font-display text-4xl md:text-6xl font-medium text-cream leading-[1.05]">
        ¿List@ para <span class="italic text-gold-light">disfrutar</span>?
      </h2>
      <p class="mt-5 text-muted">
        Escríbenos y armamos la tabla perfecta para tu ocasión.
      </p>
      <a
        href={waLink(`Hola ${site.name} 👋, quiero más información.`)}
        target="_blank"
        rel="noopener"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-gold px-8 py-4 font-medium text-charcoal shadow-glow hover:bg-gold-light transition-all hover:-translate-y-0.5"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12 2a10 10 0 0 0-8.53 15.26L2 22l4.86-1.27A10 10 0 1 0 12 2z"
          ></path></svg
        >
        Escríbenos por WhatsApp
      </a>
    </div>

    <div class="rule-gold my-16"></div>

    <!-- info -->
    <div class="grid gap-10 sm:grid-cols-3 text-center sm:text-left">
      <div>
        <h3 class="font-display text-2xl text-cream">{site.name}</h3>
        <p class="mt-2 text-xs uppercase tracking-widest2 text-gold/80">Charcutería artesanal</p>
        <p class="mt-4 text-sm text-muted leading-relaxed">{site.tagline}.</p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-gold mb-4">Contacto</h4>
        <ul class="space-y-2 text-sm text-muted">
          <li>
            <a href={waLink('Hola 👋')} target="_blank" rel="noopener" class="hover:text-cream transition-colors">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={contacto.instagramUrl} target="_blank" rel="noopener" class="hover:text-cream transition-colors">
              @{contacto.instagram}
            </a>
          </li>
          <li>
            <a href={`mailto:${contacto.email}`} class="hover:text-cream transition-colors">{contacto.email}</a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider text-gold mb-4">Zona de servicio</h4>
        <p class="text-sm text-muted leading-relaxed">{site.zona}</p>
        <p class="mt-3 text-sm text-muted">Pedidos con 24 h de anticipación.</p>
      </div>
    </div>

    <div class="mt-16 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted/70">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <p>Hecho con cariño 🧀</p>
    </div>
  </div>
</footer>

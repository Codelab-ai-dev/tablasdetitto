---
import { galeria } from '../config';
---

<section id="galeria" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="rule-gold mb-20"></div>

    <div class="reveal flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <p class="text-xs uppercase tracking-widest2 text-gold mb-4">Galería</p>
        <h2 class="font-display text-4xl md:text-5xl font-medium text-cream leading-tight">
          Un vistazo a nuestras mesas
        </h2>
      </div>
      <p class="text-sm text-muted max-w-xs sm:text-right">
        Cada montaje es único. Estos son algunos de nuestros favoritos.
      </p>
    </div>

    <!-- Grid mobile-first: 1 col → 2 → 3 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 auto-rows-[240px] sm:auto-rows-[280px]">
      {
        galeria.map((item, i) => (
          <figure
            class:list={[
              'reveal group relative overflow-hidden rounded-2xl ring-1 ring-cream/10 bg-surface',
              i === 0 ? 'sm:col-span-2 sm:row-span-2' : '',
            ]}
            style={`transition-delay:${i * 70}ms`}
          >
            <img
              src={item.src}
              alt={item.caption}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/10 to-transparent"></div>
            <figcaption class="absolute bottom-0 inset-x-0 p-5">
              <span class="text-sm text-cream/90">{item.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

---
import { site, waLink } from '../config';
---

<section id="top" class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 pb-16">
  <!-- Atmósfera: glows cálidos -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-24 left-1/2 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-gold/10 blur-[120px] animate-glow-pulse"
    >
    </div>
    <div class="absolute bottom-0 right-0 h-[380px] w-[380px] rounded-full bg-wine/20 blur-[120px]"></div>
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background:radial-gradient(circle at 50% 40%, transparent 0%, #0f0b0a 72%)"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8 w-full">
    <div class="grid md:grid-cols-2 gap-10 md:gap-8 items-center">
      <!-- Texto -->
      <div class="text-center md:text-left order-2 md:order-1">
        <p
          class="animate-fade-up text-xs sm:text-sm uppercase tracking-widest2 text-gold mb-5"
          style="animation-delay:.05s"
        >
          Charcutería artesanal
        </p>
        <h1
          class="animate-fade-up font-display text-[3.25rem] leading-[0.95] sm:text-7xl md:text-[5rem] font-semibold text-cream"
          style="animation-delay:.15s"
        >
          Sabores que<br />
          <span class="italic text-gold-light">reúnen</span> a la mesa
        </h1>
        <p
          class="animate-fade-up mt-6 text-base sm:text-lg text-muted max-w-md mx-auto md:mx-0 leading-relaxed"
          style="animation-delay:.3s"
        >
          Tablas de quesos y embutidos seleccionados, montadas a mano para tus reuniones,
          celebraciones y momentos especiales.
        </p>

        <div
          class="animate-fade-up mt-9 flex flex-col sm:flex-row gap-3 justify-center md:justify-start"
          style="animation-delay:.45s"
        >
          <a
            href={waLink(`Hola ${site.name}, quiero hacer un pedido 🧀`)}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center justify-center gap-2 rounded-full bg-gold px-7 py-3.5 font-medium text-charcoal shadow-glow hover:bg-gold-light transition-all hover:-translate-y-0.5"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12 2a10 10 0 0 0-8.53 15.26L2 22l4.86-1.27A10 10 0 1 0 12 2z"
              ></path></svg
            >
            Pedir por WhatsApp
          </a>
          <a
            href="#tablas"
            class="inline-flex items-center justify-center rounded-full border border-cream/25 px-7 py-3.5 font-medium text-cream hover:border-gold hover:text-gold-light transition-colors"
          >
            Ver las tablas
          </a>
        </div>

        <div
          class="animate-fade-in mt-10 flex items-center gap-6 justify-center md:justify-start text-xs text-muted"
          style="animation-delay:.7s"
        >
          <span class="flex items-center gap-2"><span class="text-gold">✦</span> Ingredientes selectos</span>
          <span class="flex items-center gap-2"><span class="text-gold">✦</span> Hecho a mano</span>
        </div>
      </div>

      <!-- Visual -->
      <div class="order-1 md:order-2 relative animate-fade-up" style="animation-delay:.25s">
        <div class="relative mx-auto max-w-md md:max-w-none">
          <div class="absolute -inset-2 rounded-[2rem] bg-gold/20 blur-3xl"></div>
          <img
            src="/images/tabla-1.jpg"
            alt="Tabla de charcutería artesanal de Las Tablas de Titto"
            width="631"
            height="416"
            fetchpriority="high"
            class="relative w-full rounded-3xl shadow-card ring-1 ring-gold/20 object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- indicador de scroll -->
  <a
    href="#nosotros"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-gold/60 hover:text-gold transition-colors animate-fade-in"
    style="animation-delay:1s"
    aria-label="Desplázate hacia abajo"
  >
    <svg class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
      ><path d="M12 5v14M19 12l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"></path></svg
    >
  </a>
</section>

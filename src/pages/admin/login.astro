---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { validate, COOKIE } from '../../lib/auth';

// Si ya hay sesión, ir directo al panel.
const token = Astro.cookies.get(COOKIE)?.value;
if (validate(token)) return Astro.redirect('/admin');

const err = Astro.url.searchParams.get('err');
---

<AdminLayout title="Acceso" showNav={false}>
  <div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <img src="/logo.png" alt="Las Tablas de Titto" class="mx-auto h-24 w-24 rounded-full bg-[#fbf6f0] object-contain p-1" />
        <h1 class="mt-4 font-display text-3xl text-cream">Panel de administración</h1>
        <p class="mt-1 text-sm text-muted">Inicia sesión para editar tu sitio</p>
      </div>

      {
        err && (
          <div class="mb-4 rounded-lg border border-wine/50 bg-wine/15 px-4 py-3 text-sm text-red-300">
            {err}
          </div>
        )
      }

      <form method="POST" action="/api/admin/login" class="space-y-4">
        <div>
          <label class="label" for="username">Usuario</label>
          <input class="field" type="text" id="username" name="username" autocomplete="username" required />
        </div>
        <div>
          <label class="label" for="password">Contraseña</label>
          <input class="field" type="password" id="password" name="password" autocomplete="current-password" required />
        </div>
        <button class="btn-gold w-full" type="submit">Entrar</button>
      </form>
    </div>
  </div>
</AdminLayout>

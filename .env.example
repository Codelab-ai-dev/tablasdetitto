# Credenciales del panel /admin (defínelas en Coolify → Environment Variables)
ADMIN_USER=titto
ADMIN_PASSWORD=cambia-esta-contrasena

# Reservado para firmar cookies (opcional). Usa una cadena larga y aleatoria.
SESSION_SECRET=genera-una-cadena-larga-y-aleatoria

# Servidor (Coolify puede sobreescribirlas)
HOST=0.0.0.0
PORT=4321

# Directorio de datos persistente (BD SQLite + imágenes). En Coolify monta un volumen aquí.
DATA_DIR=/app/data
